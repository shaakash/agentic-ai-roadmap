# Copy to .env and fill in. NEVER commit a real .env.

# --- Data layer ---
DUCKDB_PATH=data/benchmark.duckdb
# Synthetic data generation controls
GEN_SEED=42
GEN_START_MONTH=2023-01
GEN_NUM_MONTHS=24
GEN_NUM_MEMBERS=18            # synthetic lenders ("members") in the panel

# --- Knowledge / RAG ---
CHROMA_PATH=data/chroma
CORPUS_PATH=corpus/definitions

# --- LLM provider (planning + narration only; never computation) ---
LLM_PROVIDER=openai           # openai | azure | bedrock | local
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me
LLM_TEMPERATURE=0.0           # deterministic planning/narration

# --- Governance ---
MIN_CELL_MEMBERS=5            # k-anonymity: suppress peer cells with < this many members
DEFAULT_ENTITLEMENT=industry_only   # fallback scope if SSO claims are missing

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=delinquency-benchmarking-agent
