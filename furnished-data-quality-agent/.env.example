# Copy to .env and fill in. NEVER commit a real .env.

# --- Data layer ---
DUCKDB_PATH=data/dq.duckdb
BATCHES_PATH=data/batches        # synthetic furnished batches land here
# Synthetic data generation controls
GEN_SEED=42
GEN_NUM_BATCHES=5
GEN_RECORDS_PER_BATCH=2000
GEN_ANOMALY_RATE=0.06            # fraction of records seeded with a labeled anomaly

# --- Rule engine (deterministic core) ---
RULES_PATH=src/dq_agent/rules/rules.yaml
SEVERITY_BLOCK_THRESHOLD=high    # anomalies at/above this severity must be reviewed before any downstream use

# --- LLM provider (explanations, drafts, rule hypotheses ONLY; never detection) ---
LLM_PROVIDER=openai              # openai | azure | bedrock | local
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-me
LLM_TEMPERATURE=0.0              # deterministic drafting

# --- Generated-code sandbox ---
SANDBOX_ENABLED=true             # agent-generated rule code is ALWAYS sandbox-tested before promotion
SANDBOX_TIMEOUT_SECONDS=5
RULE_PROMOTION_MIN_PRECISION=0.95  # a candidate rule must clear this on labeled data before a human sees it
RULE_PROMOTION_MIN_RECALL=0.80

# --- Governance ---
HITL_REQUIRED=true               # corrective actions, emails, and new rules require steward approval
EMAIL_AUTOSEND=false             # furnisher emails are ALWAYS drafts; never auto-sent

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=furnished-data-quality-agent
